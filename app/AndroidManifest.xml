<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.binf.floater"
    android:versionCode="5"
    android:versionName="2.5">

    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="36" />

    <!-- 悬浮窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 检查更新：只有「打开主界面时查一次 GitHub Releases」用到，24 小时一次 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 下载完 APK 后拉起系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 把 cacheDir 里的 update.apk 交给系统安装器。
             不用 AndroidX 的 FileProvider（本项目无 Gradle / 无 AndroidX），
             自己写了个只提供这一个文件的 ContentProvider。 -->
        <provider
            android:name=".ApkProvider"
            android:authorities="com.binf.floater.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".FloatingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating binary converter overlay" />
        </service>

    </application>
</manifest>
